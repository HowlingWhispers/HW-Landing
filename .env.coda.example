# Node 24 LTS. Copy to .env.coda with mode 600; never commit credentials.
CODA_WEB_ORIGIN=https://thehowlingwhispers.com
CODA_WEB_PORT=3218
CODA_WEB_DB=/var/lib/hw-coda-web/rooms.sqlite
CODA_WEB_IMAGE_DIR=/var/lib/hw-coda-web/images
DISCORD_BOT_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OWNER_USER_ID=
# Reuse the running Discord Coda Kilo sidecar and its local authentication.
CODA_KILO_BASE_URL=http://127.0.0.1:4096
CODA_KILO_MODEL=kilo/kilo-auto/free
CODA_KILO_VISION_MODEL=kilo/kilo-auto/free
KILO_SERVER_USERNAME=kilo
KILO_SERVER_PASSWORD=
# Reuse Orbis's protected context builder so Browser and Discord Coda share the
# authenticated member's permitted profile and memory context.
CODA_ORBIS_BRIDGE_URL=http://127.0.0.1:8789/api/internal/coda-discord
CODA_ORBIS_MEMORY_URL=http://127.0.0.1:8789/api/internal/coda-memory
CODA_ORBIS_BRIDGE_SECRET=

# Shared music. Leave blank to run with no music provider at all; Coda then tells
# members plainly that nothing can be played. Generate with: openssl rand -base64 32
CODA_TOKEN_KEY=
# Set to "fake" for local development against the in-memory provider.
CODA_MUSIC_PROVIDER=
# Only these two scopes are requested. Playlist and library scopes are not used.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI registered in the Spotify dashboard exactly:
#   https://thehowlingwhispers.com/coda/api/music/spotify/callback
SPOTIFY_REDIRECT_URI=
