{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodaLauncher",
  "version": "0.1.0",
  "identifier": "com.howlingwhispers.codalauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CodaLauncher · Howling Whispers",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://* https://* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
